# Copiar a .env y completar. El .env NO se commitea.

MYSQL_ROOT_PASSWORD=cambiar_este_password

# Al menos 32 caracteres — la API no arranca si es más corta.
JWT_KEY=clave_secreta_de_al_menos_32_caracteres_aca

# El número real de WhatsApp: código de país + área + número, sin +, sin espacios
# y sin guiones. Ej: 5491155551234
#
# Es la única vía de contacto del sitio: 16 botones en todas las páginas salen de
# acá. El build del frontend FALLA si queda vacío o con un placeholder, porque un
# número muerto se hornea sin ruido y rompe todo sin que nada avise.
VITE_WHATSAPP=

# Opcional: la URL completa de la cuenta de Instagram.
# Ej: https://instagram.com/dondenosvamos
# Si queda vacío, el link no aparece en el footer.
VITE_INSTAGRAM=
