<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.dnvcasas</groupId>
    <artifactId>dnvcasas-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>dnvcasas-api</artifactId>
  <name>DNV Casas :: API</name>
  <dependencies>
    <dependency>
      <groupId>com.dnvcasas</groupId> 
      <artifactId>dnvcasas-infrastructure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!--
      resource-server y no jjwt: da un BearerTokenAuthenticationFilter correcto y,
      lo decisivo, un hook de primera clase para el clock skew — el .NET usa 5 min
      por defecto y Spring 60s. Con jjwt habría que escribir el filtro a mano.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- Swagger: el .NET lo expone en Development (AddSwaggerGen + UseSwaggerUI) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.6.0</version>
    </dependency>
    <!--
      Actuator: /health para que Docker (y cualquier orquestador) sepa si la app
      está viva y si la base responde. Sin esto, un contenedor con la conexión a
      MySQL caída figura "Up" y sigue recibiendo tráfico.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      El GoldenTest necesita una MySQL de verdad: el filtro usa LOCATE, el orden
      de los nulls depende del motor y las columnas son decimal(10,2). Con H2 o
      HSQLDB el test pasaría verde probando otra cosa.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      El cliente por defecto de RestTemplate usa HttpURLConnection, que NO soporta
      PATCH ("Invalid HTTP method: PATCH"). Los endpoints /status y /featured son
      PATCH, así que sin esto el GoldenTest no puede probarlos.
    -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!--
        Los *IT van por failsafe (mvn verify), no por surefire (mvn test):
        levantan Docker y tardan. `mvn test` sigue siendo rápido y sin
        infraestructura.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
