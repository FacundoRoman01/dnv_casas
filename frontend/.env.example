# Copiar a .env. Solo hace falta para levantar el frontend suelto (npm run dev);
# con docker compose los valores salen del .env de la raíz.

VITE_API_URL=http://localhost:5254/api

# El número real de WhatsApp: código de país + área + número, sin +, sin espacios
# y sin guiones. Ej: 5491155551234
#
# El build FALLA si esto queda como placeholder — es la única vía de contacto del
# sitio y un número muerto rompe las 16 CTAs sin que nada avise.
VITE_WHATSAPP=

# Opcional: la URL completa de la cuenta de Instagram.
# Ej: https://instagram.com/dondenosvamos
# Si queda vacío, el link no aparece en el footer.
VITE_INSTAGRAM=
